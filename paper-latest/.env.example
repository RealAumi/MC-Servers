# Project Configuration
COMPOSE_PROJECT_NAME=mc-paper-latest

# Server Ports
MC_PORT=25565
RCON_PORT=25575

# Server Basic Settings
SERVER_NAME=Paper Minecraft Server
MOTD=A Paper Minecraft Server powered by Docker
MAX_PLAYERS=20
DIFFICULTY=normal
MODE=survival
LEVEL=world
SEED=

# Performance Settings
MEMORY=2G
# JVM Optimization for Paper servers
JVM_OPTS=-XX:+UseG1GC -XX:+UnlockExperimentalVMOptions -XX:MaxGCPauseMillis=100 -XX:+DisableExplicitGC -XX:TargetSurvivorRatio=90 -XX:G1NewSizePercent=50 -XX:G1MaxNewSizePercent=80 -XX:G1MixedGCLiveThresholdPercent=35 -XX:+AlwaysPreTouch -XX:+ParallelRefProcEnabled

# Authentication
ONLINE_MODE=true

# RCON Configuration (for remote administration)
ENABLE_RCON=true
RCON_PASSWORD=changeme_please

# Player Management (comma-separated lists)
WHITELIST=
OPS=

# World Settings
ALLOW_NETHER=true
ANNOUNCE_PLAYER_ACHIEVEMENTS=true
ENABLE_COMMAND_BLOCK=false
FORCE_GAMEMODE=false
GENERATE_STRUCTURES=true
HARDCORE=false
MAX_BUILD_HEIGHT=256
MAX_WORLD_SIZE=29999984
PVP=true
SPAWN_ANIMALS=true
SPAWN_MONSTERS=true
SPAWN_NPCS=true
VIEW_DISTANCE=10

# Paper Specific
PAPER_CHANNEL=default

# Plugin Management
REMOVE_OLD_MODS=false

# Logging
ENABLE_ROLLING_LOGS=true

# Timezone
TZ=UTC